(footprint "DaisySeed_Socket_2x20" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Electrosmith Daisy Seed on two 1x20 2.54 mm female headers, rows 15.24 mm apart. Drawn as seen from the Seed's top: pins 1-20 right column bottom-to-top, 21-40 left column top-to-bottom, micro-USB end at +Y. Place on B.Cu so the Seed hangs below the carrier with its USB facing the back wall.")
